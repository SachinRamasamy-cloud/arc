  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecordBody": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "RecordBody"
      },
      "Run": {
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "validate",
              "normalize",
              "csv_to_json",
              "json_to_csv",
              "workflow"
            ],
            "title": "Operation",
            "default": "validate"
          },
          "data": {
            "title": "Data"
          },
          "file_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Id"
          },
          "required_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Required Fields"
          },
          "mappings": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Mappings"
          },
          "lowercase": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Lowercase"
          },
          "max_credits_milli": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Max Credits Milli",
            "default": 10000
          },
          "workflow_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workflow Id"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Run"
      },
      "Upload": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "maximum": 16000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Size"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "application/json",
              "text/csv",
              "text/plain"
            ],
            "title": "Content Type"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "processing",
              "storage"
            ],
            "title": "Purpose",
            "default": "processing"
          },
          "retention_hours": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Retention Hours",
            "default": 24
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "size",
          "content_type"
        ],
        "title": "Upload"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Project-scoped, server-side API secret."
      }
    }
  },
  "security": [
    {
      "ApiKey": []
    }
  ]
