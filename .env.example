# Copy with: python scripts/bootstrap.py. Never commit the generated .env.
ARC_ENV=development
ARC_DATABASE_URL=sqlite:///./.local/arc.sqlite
# Optional Docker override for a managed PostgreSQL connection.
ARC_REMOTE_DATABASE_URL=
ARC_SECRET_KEY=
ARC_ENCRYPTION_KEY=
ARC_API_ORIGIN=http://127.0.0.1:8000
ARC_PORTAL_ORIGIN=http://127.0.0.1:5173
ARC_OPERATOR_ORIGIN=http://127.0.0.1:5174
ARC_SITE_ORIGIN=http://127.0.0.1:3000
ARC_STORAGE_MODE=local
ARC_STORAGE_DIR=.local/objects
ARC_MAIL_MODE=local
ARC_NATIVE_PATH=native/build/arc-engine
ARC_REDIS_URL=
ARC_R2_ENDPOINT=
ARC_R2_BUCKET=
ARC_R2_ACCESS_KEY=
ARC_R2_SECRET_KEY=
ARC_STRIPE_SECRET_KEY=
# Optional with hosted Checkout; required only if Stripe.js is added later.
ARC_STRIPE_PUBLISHABLE_KEY=
ARC_STRIPE_WEBHOOK_SECRET=
ARC_STRIPE_CREDIT_PRICE_ID=
ARC_STRIPE_PLAN_PRICE_ID=
ARC_LIVE_ENABLED=false
ARC_LEGAL_APPROVED=false
ARC_PRICING_APPROVED=false
ARC_SECURITY_QUALIFIED=false
ARC_BACKUP_QUALIFIED=false
ARC_SMTP_HOST=
ARC_SMTP_PORT=587
ARC_SMTP_USER=
ARC_SMTP_PASSWORD=
ARC_MAIL_FROM=

# Non-commercial sample rates. Change version when publishing a different rate.
ARC_PRICE_VERSION=development-2
ARC_PROCESSING_BASE_MILLI=500
ARC_PROCESSING_KIB_MILLI=100
ARC_RECORDS_PER_1000_MILLI=1000
ARC_STORAGE_GB_MONTH_MILLI=1000
ARC_STORAGE_QUOTA_BYTES=256000000
ARC_RECORDS_QUOTA_BYTES=16000000
ARC_RECORDS_QUOTA_COUNT=10000
ARC_RECORD_MAX_BYTES=65536
ARC_RECEIPT_QUOTA_BYTES=64000000
ARC_RECEIPT_QUOTA_COUNT=4096
ARC_CURRENCY=usd
ARC_STRIPE_PLAN_MINOR=2900
ARC_STRIPE_PLAN_ALLOWANCE_MILLI=300000
ARC_STRIPE_CREDIT_PACK_MINOR=1000
ARC_STRIPE_CREDIT_PACK_MILLI=100000
