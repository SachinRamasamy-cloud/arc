# Development/staging image. Building this image does NOT qualify it for production.
FROM python:3.13-slim-bookworm AS native
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake libboost-json1.81-dev && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY native/ ./
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j2 && ctest --test-dir build --output-on-failure

FROM python:3.13-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/ ./backend/
RUN pip install --no-cache-dir ./backend && useradd --uid 10001 --create-home arc
COPY --from=native /build/build/arc-engine /app/native/build/arc-engine
COPY .env.example ./
RUN mkdir -p /app/.local/objects /app/.local/mail && chown -R arc:arc /app/.local
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "entrypoints.application:development", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
